{
  "expo": {
    "name": "DOUBLE A POS",
    "slug": "double-a-pos",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "doubleapos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#FAF8F4",
    "splash": {
      "backgroundColor": "#0F5C52",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doublea.pos"
    },
    "android": {
      "package": "com.doublea.pos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": ["expo-router", "expo-sqlite", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
