# Copy to apps/admin/.env.local and apps/mobile/.env.local respectively.
# Both apps point at the same Supabase project — it is the single source of truth.

# --- apps/admin (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- apps/mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- apps/admin push notifications (Firebase Cloud Messaging, web) ---
# Same Firebase project the Laravel API's FIREBASE_CREDENTIALS points at.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Web push certificate key — Firebase Console → Project settings → Cloud Messaging → Web configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key

# --- tooling / admin server only, never shipped to a client ---
SUPABASE_PROJECT_ID=your-project-ref
# Required to set Terminal Auth passwords from the admin Users page.
# Project Settings → API → service_role (secret). Never put this in mobile.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- pnpm create-superadmin ---
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=change-me
# SUPERADMIN_NAME=Platform
